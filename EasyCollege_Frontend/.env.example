# EasyCollege frontend configuration
# Copy to .env. Vite only exposes variables prefixed with VITE_, and they are
# embedded into the bundle at build time (rebuild after changing them).
# Values are public in the built JavaScript, so never put secrets here.

# Required. Origin of the Flask backend, without a trailing slash
# (code appends paths such as /api/login).
# Fallbacks differ per file: Navbar/Dashboard use http://localhost:5001,
# Attendance/Gpa/Cgpa/Internals/AimlDashboard use "" (same origin), and
# Login/Admin have no fallback, so always set this.
#Also, for the load balancer set the base url to the cloudflare worker :)
VITE_API_BASE_URL=http://localhost:5001

# Optional. Google Analytics 4 measurement ID. GA is only initialised when set.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
